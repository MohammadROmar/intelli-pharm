{
  "buildCommand": "VITE_VERCEL_DEPLOYMENT_ID=\"$VERCEL_DEPLOYMENT_ID\" VITE_VERCEL_SKEW_PROTECTION_ENABLED=\"$VERCEL_SKEW_PROTECTION_ENABLED\" npm run build",
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
